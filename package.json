{
  "name": "crypto-lab-matsui-line",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test",
    "test:e2e": "playwright test",
    "test:visual": "VISUAL=1 playwright test e2e/visual.spec.ts",
    "test:workflow": "node --test scripts/workflow-controls.test.mjs",
    "test:publisher": "node --test scripts/publisher-controls.test.mjs",
    "test:mutations": "node scripts/claim-mutations.mjs",
    "deploy": "gh workflow run deploy.yml --repo systemslibrarian/crypto-lab-matsui-line --ref main"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
